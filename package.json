{
  "name": "product-catalog-api",
  "version": "1.0.0",
  "description": "CRUD API for Product Catalog using Fastify",
  "main": "dist/server.js",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "npm run build && NODE_ENV=production node dist/server.js",
    "start:multi": "tsx src/cluster.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": ["fastify", "crud", "api", "product-catalog"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^11.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}